# Mercedes Sentinel environment variables.
#
# Copy this file to .env at the repo root, then fill in real values.
# .env is gitignored; .env.example is tracked so the required keys are
# documented in the repo.

# Gmail IMAP credentials for ingest.py (C1).
# IMAP_USERNAME is your Gmail address.
# IMAP_APP_PASSWORD is a 16-character app password generated at
# https://myaccount.google.com/apppasswords (requires 2-Step
# Verification on the account).
IMAP_USERNAME=your-address@gmail.com
IMAP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Anthropic API key for triage.py (C2). Get one at
# https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: recipient for the daily summary email sent by C3.
# Defaults to IMAP_USERNAME if unset (i.e., script self-mails to
# the same address it polls). Override here if you want the digest
# sent to a different address.
# EMAIL_TO=cpoland06@gmail.com
